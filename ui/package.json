{
  "name": "oonfeewrt-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"require('node:fs').writeFileSync('dist/.gitkeep','')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "tsc -p tsconfig.e2e.json && playwright test",
    "test:browser:install": "playwright install --with-deps --only-shell chromium",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "20.11.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "3.2.7"
  }
}
