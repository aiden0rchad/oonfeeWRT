# Credential-store key referenced by deploy/docker-compose.yml — never commit
passphrase
*.key
*.pem
keyring.json
*.db
*.db-*
.env
.env.*

# Probe output: contains a full inventory of a real device
report.json
probe-*.json

# Controller runtime state. Both names: deploy/ uses data/, and the command
# STATUS §0 tells a reader to run uses .run/ — which was NOT ignored, so
# following the documented instructions left a keyring.json sitting untracked
# in a public repo, one `git add -A` from being published.
data/
.run/
/local-backups/
**/.oonfeewrt-recovery/

# Exported support/recovery artifacts can contain private controller or network
# metadata. Keep downloaded bundles and interrupted local snapshots out of Git.
*.oowrtbak
oonfeewrt-diagnostics-*.zip
diagnostics-*.zip
.oonfeewrt-backup-*.db.tmp

# Local OpenWrt configuration archives contain credentials and private keys.
/*-before-factory-reset.tar*

__pycache__/
*.pyc
.DS_Store

# Go
*.test
/oonfeewrtd
/dist/
ui/playwright-report/
ui/test-results/
